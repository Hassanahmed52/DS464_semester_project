    {
      "parameters": {
        "jsCode": "const headline = $input.first().json.headline;\nconst searchResults = $input.last().json;\n\n// Extract organic results\nconst organicResults = searchResults.organic_results || [];\n\n// Format search results for the AI\nlet formattedResults = \"\";\nif (organicResults.length > 0) {\n  formattedResults = organicResults.slice(0, 5).map((result, index) => {\n    return `Source ${index + 1}:\nTitle: ${result.title}\nSnippet: ${result.snippet}\nLink: ${result.link}\n`;\n  }).join('\\n---\\n');\n} else {\n  formattedResults = \"No search results found.\";\n}\n\nreturn {\n  headline: headline,\n  searchResults: formattedResults,\n  resultCount: organicResults.length\n};"
      },
      "id": "12008d28-c7be-41da-9d5c-dc8090aff600",
      "name": "Format Search Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5344,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Extract the text from Gemini's nested structure\nconst rawData = $input.first().json;\nconst geminiText = rawData.candidates[0].content.parts[0].text;\n\n// 2. Safely get search count from previous nodes\nconst searchCount = $('Format Search Results').first().json.resultCount || 0;\n\nlet factCheckResult = {\n  headline: $('Set Headline').first().json.headline || \"Unknown\",\n  verdict: \"UNVERIFIED\",\n  reasoning: geminiText,\n  confidence: \"HIGH\", \n  // FIX: Wrap the string in brackets to make it an array\n  key_findings: [\"Match found in search snippets\"], \n  sources_checked: searchCount,\n  missing_context: \"N/A\",\n  recommendation: \"Automated check complete\",\n  checked_at: new Date().toISOString()\n};\n\n// 3. Logic to extract the verdict\nconst lowerText = geminiText.toLowerCase();\nif (lowerText.includes(\"**true**\")) {\n  factCheckResult.verdict = \"TRUE\";\n} else if (lowerText.includes(\"**false**\")) {\n  factCheckResult.verdict = \"FALSE\";\n} else if (lowerText.includes(\"**misleading**\")) {\n  factCheckResult.verdict = \"MISLEADING\";\n}\n\nreturn factCheckResult;"
      },
